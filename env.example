# Copy env.example to .env. Never commit .env.
DISCORD_TOKEN=your-bot-token

# Persistent storage directory. Defaults to ./data beside database.py.
# DATA_DIR=/data

# Default archive retention; servers can override with /privacysettings.
# Finite retention is required (1–3650 days). Default: 30.
RETENTION_DAYS=30

# Sync application commands at startup after changes.
SYNC_COMMANDS=true

# Daily verified SQLite backups; retain seven automatic snapshots.
AUTO_BACKUP=true
# BACKUP_DIR=/data/backups
