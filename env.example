# copy to .env
DISCORD_TOKEN=your-bot-token

# Optional ----------------------------------------------------------
# Where the SQLite database lives. Point this at a PERSISTENT volume on hosts that wipe
# their disk on restart/redeploy (Railway, Heroku, ...), otherwise your settings are lost.
# DATA_DIR=/data

# Auto-delete archived message text older than N days (0 = keep forever).
# RETENTION_DAYS=0
